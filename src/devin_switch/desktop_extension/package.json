{
  "name": "panels",
  "displayName": "Switch Panels",
  "description": "Live whiteboard and agent browser beside the chat.",
  "version": "0.1.0",
  "publisher": "devin-switch",
  "license": "Apache-2.0",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished", "onUri"],
  "contributes": {
    "commands": [
      { "command": "switchPanels.openCanvas", "title": "Open Whiteboard", "category": "Switch" },
      { "command": "switchPanels.openBrowser", "title": "Open Agent Browser", "category": "Switch" }
    ],
    "configuration": {
      "title": "Switch Panels",
      "properties": {
        "switchPanels.whiteboardCommand": {
          "type": "string",
          "default": "whiteboard-mcp",
          "description": "Command that prints the workspace board URL with `<command> url`."
        }
      }
    }
  }
}
